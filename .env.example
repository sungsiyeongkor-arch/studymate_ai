# Copy to .env. Never commit .env or API keys.
APP_ENV=development
# Production: generate with python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
OPENAI_API_KEY=
# Use a Responses API model enabled on YOUR project with image input.
OPENAI_MODEL=gpt-6-astra
TRANSCRIPTION_MODEL=whisper-1
AI_DAILY_REQUEST_LIMIT=100
# Omitted DATABASE_URL uses instance/studymate-v2.db (SQLite).
# DATABASE_URL=postgresql+psycopg://studymate:password@localhost:5432/studymate
# DATA_DIR=/data
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Required by Docker Compose, choose your own password:
POSTGRES_PASSWORD=

# Per-user original file budget. Pending uploads reserve bytes atomically.
STORAGE_LIMIT_BYTES=10737418240
UPLOAD_TTL_HOURS=24
# Per-process PostgreSQL connection budget; multiply by web and worker processes.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
